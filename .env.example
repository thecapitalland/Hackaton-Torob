# ---- LLM (GapGPT OpenAI-compatible API) -----------------------------------
# کلید فقط سمت بک‌اند استفاده می‌شود؛ هرگز داخل فرانت‌اند قرار نگیرد.
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://api.gapgpt.app/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MODEL_FALLBACK=gpt-4.1-mini
LLM_TIMEOUT=6
LLM_ROUTER_TIMEOUT=5
LLM_ROUTER_MIN_CONFIDENCE=0.6
LLM_STRUCTURED=auto
LLM_COST_LOG=1
DEBUG=0
# Jev is the fast action-only decider; rules always extract/filter slot values.
LLM_ROUTER_BACKEND=jev
DECIDER_MODEL=typesafe/jev-1.14
DECIDER_TIMEOUT=4
DECIDER_MIN_CONF=0.7
MESSAGE_BUDGET_S=8
# Optional OpenRouter configuration (free models have daily quota and may return 429):
# BOXAPI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=poolside/laguna-s-2.1:free
# LLM_MODEL_FALLBACK=google/gemma-4-31b-it:free
# on | off  (off = حالت قاعده‌محور، بدون تماس با LLM)
LLM_MODE=on

# ---- Neshan maps (اختیاری - نشان) -------------------------------------------
# سرویس‌کیِ نشان؛ فقط سمت بک‌اند استفاده می‌شود. اگر خالی باشد همهٔ امکانات
# جئو به‌صورت خودکار به حالت fallback (فاصلهٔ هوایی ×۱٫۳ / کافهٔ محلی) برمی‌گردد.
# نشان برای کلید نامعتبر HTTP 480 برمی‌گرداند؛ کلاینت بعد از آن ۱۰ دقیقه حالت
# غیرفعال می‌گیرد تا درخواست‌ها بی‌خودی تکرار نشوند.
NESHAN_API_KEY=

# ---- data ------------------------------------------------------------------
CATALOG_PATH=./data/catalog.db
MARKETS_PATH=./data/markets.json
SELLER_REPLIES_PATH=./data/mock_seller_replies.json
CAFES_PATH=./data/mock_cafes.json
CHECKPOINT_PATH=./data/checkpoints.db

# ---- demo ------------------------------------------------------------------
# DEMO_MODE=1 نتیجه‌ها را کاملاً تکرارپذیر می‌کند (ویدئوی دمو)
DEMO_MODE=1
DEMO_NOW=2026-10-22T15:00:00+03:30
TZ=Asia/Tehran
