# ---- LLM (BoxAPI - OpenAI compatible) -------------------------------------
# کلید فقط سمت بک‌اند استفاده می‌شود؛ هرگز داخل فرانت‌اند قرار نگیرد.
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/api/v1
LLM_MODEL=gpt-5-mini
LLM_MODEL_FALLBACK=gpt-5.4-mini
# on | off  (off = حالت قاعده‌محور، بدون تماس با LLM)
LLM_MODE=off

# ---- Neshan maps (اختیاری - نشان) -------------------------------------------
# سرویس‌کیِ نشان؛ فقط سمت بک‌اند استفاده می‌شود. اگر خالی باشد همهٔ امکانات
# جئو به‌صورت خودکار به حالت fallback (فاصلهٔ هوایی ×۱٫۳ / کافهٔ محلی) برمی‌گردد.
# نشان برای کلید نامعتبر HTTP 480 برمی‌گرداند؛ کلاینت بعد از آن ۱۰ دقیقه حالت
# غیرفعال می‌گیرد تا درخواست‌ها بی‌خودی تکرار نشوند.
NESHAN_API_KEY=

# ---- data ------------------------------------------------------------------
CATALOG_PATH=./data/catalog.db
MARKETS_PATH=./data/markets.json
SELLER_REPLIES_PATH=./data/mock_seller_replies.json
CAFES_PATH=./data/mock_cafes.json
CHECKPOINT_PATH=./data/checkpoints.db

# ---- demo ------------------------------------------------------------------
# DEMO_MODE=1 نتیجه‌ها را کاملاً تکرارپذیر می‌کند (ویدئوی دمو)
DEMO_MODE=1
DEMO_NOW=2026-10-22T15:00:00+03:30
TZ=Asia/Tehran
